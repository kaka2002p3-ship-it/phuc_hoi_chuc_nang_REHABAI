# Local chatbot (Ollama)
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
CHAT_REQUEST_TIMEOUT_SECONDS=120
CHAT_MAX_CONCURRENT_REQUESTS=1
CHAT_CONTEXT_LIMIT=12
CHAT_CLOUD_FALLBACK_ENABLED=false
CHAT_STORE_SENSITIVE_DEBUG_CONTENT=false

# Production chatbot is local-only. No cloud LLM credentials are configured.

# Database: leave DATABASE_URL empty for the default local SQLite dev DB
# (backend/data/rehabai_sessions.db, auto-created). Set e.g.
# postgresql+psycopg://user:pass@host:5432/rehabai for Postgres.
DATABASE_URL=
REHABAI_DB_PATH=
REHABAI_AUTO_CREATE_SCHEMA=1

# Auth: optional TTL override (seconds) for issued JWTs.
JWT_TTL_SECONDS=

# Inference: path to a verified model bundle (defaults to artifacts/model_v2).
# Use release/model or artifacts/ensemble_v1_research for alternative bundles.
ARTIFACTS_DIR=
MATCH_CONFIDENCE_THRESHOLD=

# Logging: optional level (DEBUG/INFO/WARNING) and log file path.
LOG_LEVEL=
LOG_FILE=
