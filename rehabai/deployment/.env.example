POSTGRES_DB=rehabai
POSTGRES_USER=rehabai
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://rehabai:replace-with-a-long-random-password@postgres:5432/rehabai
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
CHAT_REQUEST_TIMEOUT_SECONDS=120
CHAT_MAX_CONCURRENT_REQUESTS=1
CHAT_CONTEXT_LIMIT=12
CHAT_CLOUD_FALLBACK_ENABLED=false
CHAT_STORE_SENSITIVE_DEBUG_CONTENT=false
REHABAI_BREATH_INHALE_SECONDS=4
REHABAI_BREATH_HOLD_SECONDS=0
REHABAI_BREATH_EXHALE_SECONDS=6
REHABAI_BREATH_REST_SECONDS=0
REHABAI_BREATH_TARGET_CYCLES=6
REHABAI_BREATH_CALIBRATION_SECONDS=2
REHABAI_BREATH_MIN_LANDMARK_VISIBILITY=0.60
REHABAI_BREATH_MIN_GOOD_FRAMES_RATIO=0.70
REHABAI_BREATH_EMA_ALPHA=0.20
REHABAI_BREATH_RISE_THRESHOLD=0.010
REHABAI_BREATH_FALL_THRESHOLD=-0.010
REHABAI_BREATH_NEUTRAL_THRESHOLD=0.004
REHABAI_BREATH_MIN_PHASE_FRAMES=5
REHABAI_BREATH_SHORT_GAP_FRAMES=3
REHABAI_BREATH_LONG_GAP_FRAMES=15
REHABAI_BREATH_MAX_NORMALIZED_JUMP=0.08
REHABAI_BREATH_MIN_CYCLE_SECONDS=4
REHABAI_BREATH_MAX_CYCLE_SECONDS=20
REHABAI_BREATH_COUNT_COOLDOWN_SECONDS=1
REHABAI_BREATH_BODY_MOTION_THRESHOLD=0.12
